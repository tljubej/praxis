// primes — trial-division prime counting.
//
// Pure Int arithmetic in a tight loop with one function call per candidate.
// The inner loop is a multiply, a compare and a remainder; no allocation the
// program can see, no collections, no branches that depend on data the CPU
// cannot predict. This is the benchmark that isolates scalar arithmetic and
// call overhead from everything else.
//
// Input: the exclusive upper limit, as one integer on stdin.
// Output: the number of primes below the limit, then their sum.

fn is_prime(n: Int) -> Bool {
    if n < 2 { return false }
    if n % 2 == 0 { return n == 2 }
    var d = 3
    while d * d <= n {
        if n % d == 0 { return false }
        d = d + 2
    }
    true
}

let limit = read int

var count = 0
var total = 0
var n = 2
while n < limit {
    if is_prime(n) {
        count = count + 1
        total = total + n
    }
    n = n + 1
}

out(count)
out(total)
