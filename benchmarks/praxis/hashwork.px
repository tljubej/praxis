// hashwork — hash-collection throughput.
//
// The three keyed collections a puzzle actually reaches for, driven by a
// deterministic LCG so all three implementations touch the same keys in the
// same order: a `Map` taking inserts that mostly collide with earlier keys, a
// `Set` taking a heavily-duplicated stream, a `Counter` taking increments, and
// then a second pass of pure lookups against a key stream that misses about a
// third of the time. Ends by iterating the counter's values.
//
// The LCG is written so no intermediate exceeds 2^62: the multiplier is under
// 2^31 and the state is reduced mod 2^31 every step, which also makes the
// remainders identical under Python's floored `%` and Praxis's truncated one.
//
// Input: the number of LCG steps per pass, as one integer on stdin.
// Output: the map's size, the set's size, the counter's total, then the hit
// count of the lookup pass.

var n = read int

var m = Map()
var seen = Set()
var counts = Counter()

var state = 12345
var i = 0
while i < n {
    state = (state * 1103515245 + 12345) % 2147483648
    var k = state % 65536
    m.insert(k, i)
    seen.insert(k % 1024)
    counts[k % 256] += 1
    i = i + 1
}

var probe = 999
var hits = 0
var j = 0
while j < n {
    probe = (probe * 1103515245 + 12345) % 2147483648
    var k = probe % 98304
    if m.contains(k) {
        hits = hits + 1
    }
    j = j + 1
}

out(m.len())
out(seen.len())
out(counts.values().sum())
out(hits)
