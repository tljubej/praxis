// Three frames, each with its own locals: `p` sees exactly the selected
// frame's, and nothing else in the program.
fn cell(grid: Vec[Int], at: Int) -> Int {
    grid[at]
}

fn edge(grid: Vec[Int], width: Int) -> Int {
    var row = 2
    cell(grid, row * width)
}

fn main() {
    var grid = [1, 2, 3, 4, 5, 6]
    var width = 3
    out(edge(grid, width))
}
