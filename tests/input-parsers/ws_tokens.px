// Input-parser fixture: `ws(P)` at the ROOT, over a newline-terminated file.
//
// §7.5's `ws(parser)` splits on spaces or tabs. The input this reads is an
// ordinary file, so it ends with `\n` — and the root region has to end where
// the data ends, or the last token is `3\n` and `int` is asked to eat the
// terminator. Every other `ws` test in the tree deliberately omits the newline,
// which is how that got through.
fn main() -> Int {
    let v = read ws(int);
    var total = 0;
    for n in v {
        total = total + n;
    }
    total
}
