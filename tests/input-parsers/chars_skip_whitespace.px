// Input-parser fixture: §7.5's `chars(one_of("^v<>"), skip: whitespace)`
// example, verbatim, at the ROOT over a newline-terminated file.
//
// `skip: whitespace` is horizontal whitespace — spaces and tabs — so it cannot
// absorb the file's trailing `\n`; the newline has to be outside the region
// instead. The corpus already used this constructor, but only nested inside
// `sections`, whose section regions exclude their line ending — so the one
// fixture that exercised §7.5's example was exactly the shape where the defect
// was invisible.
fn main() -> Int {
    let moves = read chars(one_of("^v<>"), skip: whitespace);
    moves.len()
}
