// ADR-085: `Text + Text` is concatenation, and `+` is the only operator
// defined for `Text`. This runs the shapes a puzzle solution actually writes:
// building a label out of parsed fields, accumulating into a `var`, and using a
// built `Text` as a map key.
//
// `+` does not coerce, and it never will: ADR-085 decision 2 refuses an implicit
// conversion to `Text`. What has changed since this was written is that the
// conversion now exists *explicitly* — `Int.to_text()` and `Char.to_text()`
// landed with ADR-143 — so the last two lines concatenate a number and a
// character by saying so, which is exactly what that decision asked for.
var rows = read lines(`{first:word} {second:word}`)

var report = ""
var index = Map()

for row in rows {
    var label = row.first + "/" + row.second
    report += label + " "
    index[label] = row.first
}

out(report)
out(index["beta/two"])
out(("" + "").is_empty())
out(("a" + "b" + "c" + "d").len())
out("héllo" + " wörld")

// The explicit conversion, at the two shapes a labelled line takes.
out("rows=" + rows.count().to_text())
out("first=" + rows[0].first[0].to_text())
