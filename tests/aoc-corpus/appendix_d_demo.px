var pairs = read lines(`{left:int} {right:int}`)

var left = pairs.map(|p| p.left).sorted()
var right = pairs.map(|p| p.right).sorted()

var distance = left
    .zip(right)
    .map(|(a, b)| abs(a - b))
    .sum()

var counts = right.frequencies()
var similarity = left
    .map(|value| value * counts[value])
    .sum()

out(distance)
out(similarity)
