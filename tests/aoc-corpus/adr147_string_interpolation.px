// AoC corpus fixture: string interpolation (§8.1, ADR-147).
//
// Handover 31 item 3's complaint was that every labelled debug line during a
// real solve was two calls — `out("splits:")` then `out(splits)` — because there
// was no third thing to write. ADR-143 closed that for the four types with a
// `to_text()` row; this fixture is the shape of a solve once a hole renders
// *anything*, which is the half that only interpolation could give.
//
// Three properties are pinned here rather than in a unit test, because each is
// only visible from a whole program:
//
//   1. A hole renders what `out` renders, for a type with no `to_text()`. Every
//      "rendered" line below is printed twice — once through a hole and once by
//      handing the same value to `out` — so the two must agree line for line.
//   2. A hole holds a full expression, evaluated in source order.
//   3. A closure body that names an outer binding **only inside a hole** still
//      captures it. That one has no compile-time symptom: an implementation that
//      re-lexed holes in a later pass runs and prints something else.
//
// No input. Output: the lines below, each rendered pair identical.

struct Reading { site: Text, depth: Int }

enum Cell { Wall, Open, Marked(Int) }

// A labelled line, for a type the `to_text` family does not cover.
fn labelled(name: Text, values: Vec[Int]) -> Text {
    "{name}: {values}"
}

// A hole is a full expression: arithmetic, a field, a tuple element, a method
// call, a subscript, and an `if` all read the same inside one as outside.
fn summary(r: Reading, span: (Int, Int), depths: Vec[Int], by_site: Map[Text, Int]) -> Text {
    var head = "{r.site} at {r.depth}m, span {span.0}..{span.1} ({span.1 - span.0} wide)"
    var body = "{depths.len()} readings, deepest {by_site["trench"]}"
    var tail = "verdict {if r.depth > 100 { "deep" } else { "shallow" }}"
    "{head}, {body}, {tail}"
}

// The capture case. `origin` and `unit` are named only inside holes, so a
// closure that does not capture them prints an empty label or crashes.
fn make_stamp(origin: Text, unit: Text) -> (Int) -> Text {
    |n: Int| "{origin}+{n}{unit}"
}

fn main() {
    // 1. A hole renders what `out` renders — the same characters, for types
    //    with no `to_text()` row at all.
    var depths = [12, 40, 7, 118]
    var sites = Map[Text, Int]()
    sites["trench"] = 118
    sites["shelf"] = 12
    var grid = Grid(3, 2, '.')
    grid[1, 0] = '#'
    var cells = [Wall, Marked(3)]
    var reading = Reading { site: "trench", depth: 118 }
    var span = (7, 118)

    out("{depths}")
    out(depths)
    out("{sites}")
    out(sites)
    out("{grid}")
    out(grid)
    out("{cells}")
    out(cells)
    out("{reading}")
    out(reading)
    out("{span}")
    out(span)

    // 2. The labelled line handover 31 asked for, now one call for a `Vec`.
    out(labelled("depths", depths))
    out(summary(reading, span, depths, sites))

    // 3. Source order: a hole with an effect runs where it is written.
    var seen = Vec[Int]()
    var order = "{bump(seen, 1)}{bump(seen, 2)}{bump(seen, 3)}"
    out("order {order}, seen {seen}")

    // 4. The capture, through a closure returned from a function — so the
    //    environment has to be filled at the allocation site, not read from a
    //    frame that is gone by the time it is called.
    var stamp = make_stamp("base", "m")
    out(stamp(0))
    out(stamp(40))

    // 5. A literal brace, and a `}` that closes nothing.
    out("a hole is \{expr\}, and a bare } is just a brace")
}

fn bump(v: Vec[Int], n: Int) -> Int {
    v.push(n)
    n
}
