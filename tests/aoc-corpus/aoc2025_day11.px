// AoC 2025 day 11 — "Reactor": counting paths through a device graph.
//
// Each line is a device and the devices its outputs feed. Data only flows
// forward, and the graph is acyclic, so the number of paths from a node is the
// sum over its outputs — memoized, because the same device is reached along
// many prefixes and its suffix count does not depend on how you got there.
// Without the memo this is exponential; the real input has 648 devices and
// 2.07e17 paths from `svr`, so enumerating them is not an option.
//
// Part 1 counts every path from `you` to `out`.
//
// Part 2 counts the paths from `svr` to `out` that visit **both** `dac` and
// `fft`, in either order. That is the same walk with two bits of history added
// to the state: which of the two have been seen on the way in. A path is
// counted at `out` only if both bits are set, so the memo is keyed on
// `(device, seen)` rather than on `device` alone — the suffix count genuinely
// differs by what the prefix already visited.
//
// Two bits, as a small integer: 0 = neither, 1 = dac, 2 = fft, 3 = both.
// Praxis has no bitwise operators, so the transitions are written out.

var rows = read lines(`{name:word}: {outs:ws(word)}`)

var adj = Map()
for row in rows {
    adj[row.name] = row.outs
}

// Part 1: paths to `target`, memoized on the device alone.
fn count_paths(
    adj: Map[Text, Vec[Text]],
    memo: Map[Text, Int],
    node: Text,
    target: Text,
) -> Int {
    if node == target { return 1 }
    if memo.contains(node) { return memo[node] }
    var total = 0
    match adj.get(node) {
        Some(outs) => {
            for o in outs {
                total = total + count_paths(adj, memo, o, target)
            }
        }
        None => {}
    }
    memo.insert(node, total)
    total
}

// Part 2: the same count, carrying which of the two required devices the path
// has already been through. `seen` is that set on the way *in*; `m` adds this
// device's own contribution before the memo is consulted, so two prefixes that
// arrive at one device having seen the same set share an entry.
fn count_via_both(
    adj: Map[Text, Vec[Text]],
    memo: Map[(Text, Int), Int],
    node: Text,
    seen: Int,
    first: Text,
    second: Text,
    target: Text,
) -> Int {
    var m = seen
    if node == first {
        if m == 0 { m = 1 } else if m == 2 { m = 3 }
    }
    if node == second {
        if m == 0 { m = 2 } else if m == 1 { m = 3 }
    }
    if node == target {
        return if m == 3 { 1 } else { 0 }
    }
    var key = (node, m)
    if memo.contains(key) { return memo[key] }
    var total = 0
    match adj.get(node) {
        Some(outs) => {
            for o in outs {
                total = total + count_via_both(adj, memo, o, m, first, second, target)
            }
        }
        None => {}
    }
    memo.insert(key, total)
    total
}

var memo1 = Map()
out(count_paths(adj, memo1, "you", "out"))

var memo2 = Map()
out(count_via_both(adj, memo2, "svr", 0, "dac", "fft", "out"))
