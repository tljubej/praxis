/target
# Insta pending snapshot updates (review and accept, never commit these).
*.snap.new
*.pending-snap
# Editor / OS / tooling clutter.
.vscode/
.idea/
.DS_Store
.zcode/

# Agent worktrees (git worktree checkouts live here; never part of a commit)
.claude/worktrees/

# The VS Code extension's own build output (editors/vscode). Not part of a
# commit: `just ci` does not build it, and M14 packages it from source.
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/*.vsix

# The book's rendered HTML (`mdbook build` output). The source under
# docs/book/src is committed; the render is not.
docs/book/book/

# The benchmark suite's compiled Rust binaries (benchmarks/run.py builds them
# with `rustc` on demand). `results.json` and `REPORT.md` are *not* ignored:
# they are the evidence the report is generated from.
benchmarks/.build/

# The website's recording scratch dir (www/tools/capture.py rebuilds it).
www/tools/.build/
__pycache__/
